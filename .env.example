# Use a private IPv4 address here to accept uploads from LAN services.
STORE_API_BIND=127.0.0.1
STORE_API_PORT=8767
# Only the download listener should be forwarded by the IPv6 HTTPS ingress.
STORE_DOWNLOAD_BIND=127.0.0.1
STORE_DOWNLOAD_PORT=8766
STORE_REPO_URL=http://127.0.0.1:8766/fdroid/repo
STORE_MAX_APK_BYTES=536870912
STORE_UID=1000
STORE_GID=1000
