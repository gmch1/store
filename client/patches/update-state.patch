+package com.looker.droidify.update
+
+import android.content.Context
+import androidx.fragment.app.Fragment
+import com.looker.droidify.database.Database
+import com.looker.droidify.datastore.SettingsRepository
+import com.looker.droidify.datastore.get
+import com.looker.droidify.model.ProductItem
+import com.looker.droidify.utility.common.Constants
+import com.looker.droidify.utility.common.extension.notificationManager
+import com.looker.droidify.utility.notifications.updatesAvailableNotification
+import dagger.hilt.android.qualifiers.ApplicationContext
+import java.lang.ref.WeakReference
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.flatMapLatest
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/** Keeps an existing update notification consistent with installed packages and repository data. */
+@Singleton
+class UpdateNotifications @Inject constructor(
+    @ApplicationContext private val context: Context,
+    private val settingsRepository: SettingsRepository,
+) {
+    private val refreshLock = Mutex()
+    private var blocker: WeakReference<Fragment>? = null
+
+    @OptIn(ExperimentalCoroutinesApi::class)
+    suspend fun observe() {
+        settingsRepository.get { ignoreSignature to notifyUpdate }
+            .flatMapLatest { (skipSignature, _) ->
+                Database.ProductAdapter.getUpdatesStream(skipSignature)
+            }
+            .collect { refresh() }
+    }
+
+    @Synchronized
+    fun setBlocker(fragment: Fragment?) {
+        blocker = fragment?.let(::WeakReference)
+        if (fragment != null) context.notificationManager?.cancel(Constants.NOTIFICATION_ID_UPDATES)
+    }
+
+    @Synchronized
+    fun isBlocked(): Boolean = blocker?.get()?.isAdded == true
+
+    suspend fun refresh(allowNew: Boolean = false): List<ProductItem> = refreshLock.withLock {
+        val settings = settingsRepository.getInitial()
+        // Query after acquiring the lock so an older result cannot overwrite a newer one.
+        val updates = Database.ProductAdapter.getUpdates(settings.ignoreSignature)
+        synchronized(this) {
+            val manager = context.notificationManager
+            val active = manager?.activeNotifications?.any {
+                it.id == Constants.NOTIFICATION_ID_UPDATES && it.tag == null
+            } == true
+            when {
+                updates.isEmpty() || !settings.notifyUpdate || isBlocked() ->
+                    manager?.cancel(Constants.NOTIFICATION_ID_UPDATES)
+                allowNew || active -> manager?.notify(
+                    Constants.NOTIFICATION_ID_UPDATES,
+                    updatesAvailableNotification(context, updates),
+                )
+            }
+        }
+        updates
+    }
+}
