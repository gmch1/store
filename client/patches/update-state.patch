+package com.looker.droidify.update
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.os.SystemClock
+import com.looker.droidify.database.Database
+import com.looker.droidify.service.Connection
+import com.looker.droidify.service.SyncService
+import dagger.hilt.android.qualifiers.ApplicationContext
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlin.time.Duration.Companion.minutes
+
+/** Foreground checks use normal conditional HTTP requests, independently of background scheduling. */
+@Singleton
+class ForegroundSync @Inject constructor(
+    @ApplicationContext private val context: Context,
+) {
+    private val lock = Mutex()
+    private var lastAttempt: Long? = null
+
+    @Suppress("DEPRECATION")
+    suspend fun syncIfStale() = lock.withLock {
+        val network = context.getSystemService(Context.CONNECTIVITY_SERVICE) as? ConnectivityManager
+        if (network?.activeNetworkInfo?.isConnected != true) return@withLock
+        val elapsed = SystemClock.elapsedRealtime()
+        if (lastAttempt?.let { elapsed - it in 0 until INTERVAL } == true) return@withLock
+        val repos = Database.RepositoryAdapter.getAll().filter { it.enabled }
+        if (repos.isEmpty()) return@withLock
+        val now = System.currentTimeMillis()
+        if (repos.all { now - it.updated in 0 until INTERVAL }) return@withLock
+        val connection = Connection(
+            SyncService::class.java,
+            onBind = { connection, binder ->
+                try {
+                    binder.sync(SyncService.SyncRequest.MANUAL)
+                } finally {
+                    connection.unbind(context)
+                }
+            },
+        )
+        if (connection.bind(context)) lastAttempt = elapsed
+    }
+
+    companion object {
+        private val INTERVAL = 5.minutes.inWholeMilliseconds
+    }
+}
