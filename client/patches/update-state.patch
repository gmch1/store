@@ -0,0 +1,100 @@
+package com.looker.droidify.update
+
+import android.app.Application
+import android.content.ComponentName
+import android.content.Intent
+import android.content.Context
+import android.content.ServiceConnection
+import android.net.ConnectivityManager
+import android.net.NetworkInfo
+import com.looker.droidify.database.Database
+import com.looker.droidify.model.Repository
+import com.looker.droidify.service.SyncService
+import io.mockk.*
+import java.time.Duration
+import kotlinx.coroutines.test.runTest
+import org.junit.After
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.shadows.ShadowSystemClock
+
+@Suppress("DEPRECATION")
+@RunWith(RobolectricTestRunner::class)
+@Config(application = Application::class, manifest = Config.NONE, sdk = [35])
+class ForegroundSyncTest {
+    private lateinit var context: Context
+    private lateinit var networkInfo: NetworkInfo
+    private lateinit var sync: ForegroundSync
+    private val connection = slot<ServiceConnection>()
+    private var repos = emptyList<Repository>()
+
+    @Before
+    fun setUp() {
+        context = mockk(relaxed = true)
+        val connectivity = mockk<ConnectivityManager>()
+        networkInfo = mockk()
+        every { context.getSystemService(Context.CONNECTIVITY_SERVICE) } returns connectivity
+        every { connectivity.activeNetworkInfo } returns networkInfo
+        every { networkInfo.isConnected } returns true
+        every { context.bindService(any<Intent>(), capture(connection), any<Int>()) } returns true
+        mockkObject(Database.RepositoryAdapter)
+        every { Database.RepositoryAdapter.getAll() } answers { repos }
+        repos = listOf(repo())
+        sync = ForegroundSync(context)
+    }
+
+    @After
+    fun tearDown() = unmockkObject(Database.RepositoryAdapter)
+
+    @Test
+    fun openingAndReturningChecksOnceWithinFiveMinutesAndKeepsConditionalCaching() = runTest {
+        sync.syncIfStale()
+        val binder = mockk<SyncService.Binder>(relaxed = true)
+        connection.captured.onServiceConnected(ComponentName("com.example", "Sync"), binder)
+        verify { binder.sync(SyncService.SyncRequest.MANUAL) }
+        verify { context.unbindService(connection.captured) }
+        sync.syncIfStale()
+        verify(exactly = 1) { context.bindService(any<Intent>(), any<ServiceConnection>(), any<Int>()) }
+        ShadowSystemClock.advanceBy(Duration.ofMinutes(5))
+        sync.syncIfStale()
+        verify(exactly = 2) { context.bindService(any<Intent>(), any<ServiceConnection>(), any<Int>()) }
+        // FORCE would clear these HTTP validators; a foreground check must preserve them.
+        verify(exactly = 0) { Database.RepositoryAdapter.put(any(), any()) }
+    }
+
+    @Test
+    fun offlineEntryDoesNotConsumeNextForegroundAttempt() = runTest {
+        every { networkInfo.isConnected } returns false
+        sync.syncIfStale()
+        verify(exactly = 0) { context.bindService(any<Intent>(), any<ServiceConnection>(), any<Int>()) }
+        every { networkInfo.isConnected } returns true
+        sync.syncIfStale()
+        verify(exactly = 1) { context.bindService(any<Intent>(), any<ServiceConnection>(), any<Int>()) }
+    }
+
+    @Test
+    fun failedBindingCanRetryImmediately() = runTest {
+        every { context.bindService(any<Intent>(), capture(connection), any<Int>()) } returnsMany listOf(false, true)
+        sync.syncIfStale()
+        sync.syncIfStale()
+        verify(exactly = 2) { context.bindService(any<Intent>(), any<ServiceConnection>(), any<Int>()) }
+    }
+
+    @Test
+    fun freshRepositoriesAndDisabledRepositoriesDoNotTriggerNetworkRequests() = runTest {
+        repos = listOf(repo().copy(updated = System.currentTimeMillis()), repo().copy(enabled = false))
+        sync.syncIfStale()
+        repos = repos.map { it.copy(enabled = false) }
+        sync.syncIfStale()
+        repos = emptyList()
+        sync.syncIfStale()
+        verify(exactly = 0) { context.bindService(any<Intent>(), any<ServiceConnection>(), any<Int>()) }
+    }
+
+    private fun repo() = Repository.newRepository("https://store.example.invalid/repo", "", "").copy(
+        id = 1, enabled = true, updated = 0, entityTag = "cached-index", lastModified = "cached-date",
+    )
+}
