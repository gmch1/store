+package com.looker.droidify.update
+
+import android.app.Application
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageInfo
+import android.net.Uri
+import androidx.test.core.app.ApplicationProvider
+import com.looker.droidify.database.Database
+import com.looker.droidify.receivers.InstalledAppReceiver
+import com.looker.droidify.utility.common.Constants
+import com.looker.droidify.utility.notifications.installNotification
+import io.mockk.*
+import org.junit.After
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(application = Application::class, manifest = Config.NONE, sdk = [35])
+class InstalledAppReceiverTest {
+    private lateinit var context: Context
+    private lateinit var manager: NotificationManager
+    private lateinit var receiver: InstalledAppReceiver
+    private val packageName = "com.example.updated"
+
+    @Before
+    fun setUp() {
+        context = ApplicationProvider.getApplicationContext()
+        manager = context.getSystemService(NotificationManager::class.java)
+        manager.createNotificationChannel(NotificationChannel(
+            Constants.NOTIFICATION_CHANNEL_INSTALL, "Install", NotificationManager.IMPORTANCE_DEFAULT,
+        ))
+        manager.cancelAll()
+        mockkObject(Database.InstalledAdapter)
+        every { Database.InstalledAdapter.put(any()) } just Runs
+        every { Database.InstalledAdapter.delete(any()) } just Runs
+        receiver = InstalledAppReceiver(context.packageManager)
+    }
+
+    @After
+    fun tearDown() {
+        unmockkObject(Database.InstalledAdapter)
+        manager.cancelAll()
+    }
+
+    @Test
+    fun replacementRemovalDoesNotTemporarilyDeleteInstalledVersion() {
+        receiver.onReceive(context, Intent(Intent.ACTION_PACKAGE_REMOVED, Uri.parse("package:$packageName"))
+            .putExtra(Intent.EXTRA_REPLACING, true))
+        verify(exactly = 0) { Database.InstalledAdapter.delete(any()) }
+        verify(exactly = 0) { Database.InstalledAdapter.put(any()) }
+    }
+
+    @Test
+    fun successfulExternalOrLegacyInstallationUpdatesSnapshotAndClearsTapToInstall() {
+        shadowOf(context.packageManager).installPackage(PackageInfo().apply {
+            packageName = this@InstalledAppReceiverTest.packageName
+            versionName = "2.0"
+            longVersionCode = 2
+        })
+        manager.installNotification(packageName, Notification.Builder(context, Constants.NOTIFICATION_CHANNEL_INSTALL)
+            .setSmallIcon(android.R.drawable.ic_dialog_info).build())
+        receiver.onReceive(context, Intent(Intent.ACTION_PACKAGE_ADDED, Uri.parse("package:$packageName")))
+        verify { Database.InstalledAdapter.put(match { it.packageName == packageName && it.versionCode == 2L }) }
+        assertTrue(manager.activeNotifications.isEmpty())
+    }
+
+    @Test
+    fun genuineUninstallRemovesInstalledSnapshot() {
+        receiver.onReceive(context, Intent(Intent.ACTION_PACKAGE_REMOVED, Uri.parse("package:$packageName")))
+        verify { Database.InstalledAdapter.delete(packageName) }
+    }
+}
