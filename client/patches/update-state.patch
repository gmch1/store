+package com.looker.droidify.update
+
+import android.app.Application
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.content.Context
+import androidx.test.core.app.ApplicationProvider
+import androidx.fragment.app.Fragment
+import com.looker.droidify.database.Database
+import com.looker.droidify.datastore.Settings
+import com.looker.droidify.datastore.SettingsRepository
+import com.looker.droidify.model.ProductItem
+import com.looker.droidify.utility.common.Constants
+import io.mockk.coEvery
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.mockkObject
+import io.mockk.unmockkObject
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@OptIn(ExperimentalCoroutinesApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(application = Application::class, sdk = [35])
+class UpdateNotificationsTest {
+    private lateinit var context: Context
+    private lateinit var manager: NotificationManager
+    private lateinit var notifier: UpdateNotifications
+    private val settings = MutableStateFlow(Settings())
+    private val updates = MutableStateFlow<List<ProductItem>>(emptyList())
+
+    @Before
+    fun setUp() {
+        context = ApplicationProvider.getApplicationContext()
+        manager = context.getSystemService(NotificationManager::class.java)
+        manager.createNotificationChannel(NotificationChannel(
+            Constants.NOTIFICATION_CHANNEL_UPDATES, "Updates", NotificationManager.IMPORTANCE_DEFAULT,
+        ))
+        manager.cancelAll()
+        val preferences = mockk<SettingsRepository>()
+        every { preferences.data } returns settings
+        coEvery { preferences.getInitial() } answers { settings.value }
+        mockkObject(Database.ProductAdapter)
+        coEvery { Database.ProductAdapter.getUpdates(any()) } answers { updates.value }
+        every { Database.ProductAdapter.getUpdatesStream(any()) } returns updates
+        notifier = UpdateNotifications(context, preferences)
+    }
+
+    @After
+    fun tearDown() {
+        manager.cancelAll()
+        unmockkObject(Database.ProductAdapter)
+    }
+
+    @Test
+    fun manualInstallationRefreshesRemainingAppsAndCancelsLastUpdate() = runTest {
+        updates.value = listOf(app("one"), app("two"))
+        notifier.refresh(allowNew = true)
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { notifier.observe() }
+
+        // This is the database change emitted by an install broadcast, with autoUpdate disabled.
+        updates.value = listOf(app("two"))
+        runCurrent()
+        val notification = active().single().notification
+        assertEquals(1, notification.extras.getCharSequenceArray(Notification.EXTRA_TEXT_LINES)!!.size)
+        assertTrue(notification.extras.getCharSequenceArray(Notification.EXTRA_TEXT_LINES)!![0].contains("two"))
+        assertTrue(notification.flags and Notification.FLAG_ONLY_ALERT_ONCE != 0)
+
+        updates.value = emptyList()
+        runCurrent()
+        assertTrue(active().isEmpty())
+    }
+
+    @Test
+    fun startupRemovesStaleNotificationIncludingAfterSelfReplacement() = runTest {
+        updates.value = listOf(app("store"))
+        notifier.refresh(allowNew = true)
+        updates.value = emptyList()
+        // A new process starts with a fresh package snapshot and the previous OS notification.
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { notifier.observe() }
+        runCurrent()
+        assertTrue(active().isEmpty())
+    }
+
+    @Test
+    fun dismissedNotificationIsNotRecreatedByPackageChanges() = runTest {
+        updates.value = listOf(app("one"), app("two"))
+        notifier.refresh(allowNew = true)
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { notifier.observe() }
+        manager.cancel(Constants.NOTIFICATION_ID_UPDATES)
+        updates.value = listOf(app("two"))
+        runCurrent()
+        assertTrue(active().isEmpty())
+    }
+
+    @Test
+    fun disablingUpdateNotificationsCancelsExistingNotification() = runTest {
+        updates.value = listOf(app("one"))
+        notifier.refresh(allowNew = true)
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { notifier.observe() }
+        settings.value = settings.value.copy(notifyUpdate = false)
+        runCurrent()
+        assertTrue(active().isEmpty())
+        notifier.refresh(allowNew = true)
+        assertTrue(active().isEmpty())
+    }
+
+    @Test
+    fun updatesPageSuppressesNoticesUntilItIsLeft() = runTest {
+        updates.value = listOf(app("one"))
+        notifier.refresh(allowNew = true)
+        val fragment = mockk<Fragment>()
+        every { fragment.isAdded } returns true
+        notifier.setBlocker(fragment)
+        notifier.refresh(allowNew = true)
+        assertTrue(active().isEmpty())
+        notifier.setBlocker(null)
+        notifier.refresh(allowNew = true)
+        assertEquals(1, active().size)
+    }
+
+    @Test
+    fun syncWithNoUpdatesCancelsOldNoticeAndPreservesUnrelatedNotifications() = runTest {
+        updates.value = listOf(app("one"))
+        notifier.refresh(allowNew = true)
+        manager.notify(9876, Notification.Builder(context, Constants.NOTIFICATION_CHANNEL_UPDATES)
+            .setSmallIcon(android.R.drawable.ic_dialog_info).build())
+        updates.value = emptyList()
+        notifier.refresh(allowNew = true)
+        assertTrue(active().isEmpty())
+        assertEquals(9876, manager.activeNotifications.single().id)
+    }
+
+    private fun active() = manager.activeNotifications.filter {
+        it.id == Constants.NOTIFICATION_ID_UPDATES && it.tag == null
+    }
+
+    private fun app(name: String) = ProductItem(
+        repositoryId = 1, packageName = "com.example.$name", name = name, summary = "",
+        icon = "", metadataIcon = "", version = "2", installedVersion = "1",
+        compatible = true, canUpdate = true, matchRank = 0,
+    )
+}
