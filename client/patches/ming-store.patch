diff --git a/app/src/test/kotlin/com/looker/droidify/database/table/PrivateStoreDatabaseTest.kt b/app/src/test/kotlin/com/looker/droidify/database/table/PrivateStoreDatabaseTest.kt
new file mode 100644
index 0000000..14d77e1
--- /dev/null
+++ b/app/src/test/kotlin/com/looker/droidify/database/table/PrivateStoreDatabaseTest.kt
@@ -0,0 +1,162 @@
+package com.looker.droidify.database.table
+
+import android.app.Application
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import androidx.test.core.app.ApplicationProvider
+import com.looker.droidify.StoreConfig
+import com.looker.droidify.database.Database.RepositoryAdapter
+import com.looker.droidify.database.Database.Schema
+import com.looker.droidify.database.Database.jsonParse
+import com.looker.droidify.index.OemRepositoryParser
+import com.looker.droidify.model.Repository
+import com.looker.droidify.utility.serialization.repository
+import io.mockk.every
+import io.mockk.mockkObject
+import io.mockk.unmockkObject
+import io.mockk.verify
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(application = Application::class, manifest = Config.NONE, sdk = [35])
+class PrivateStoreDatabaseTest {
+
+    private lateinit var context: Context
+    private lateinit var helper: DatabaseHelper
+
+    @Before
+    fun setUp() {
+        context = ApplicationProvider.getApplicationContext()
+        context.deleteDatabase("droidify")
+        helper = DatabaseHelper(context)
+        mockkObject(OemRepositoryParser)
+        every { OemRepositoryParser.getSystemDefaultRepos() } returns listOf(
+            Repository.newRepository("https://device.example.invalid/repo", "DEVICE", ""),
+        )
+    }
+
+    @After
+    fun tearDown() {
+        helper.close()
+        context.deleteDatabase("droidify")
+        unmockkObject(OemRepositoryParser)
+    }
+
+    @Test
+    fun firstCreationSeedsOnlyTheEnabledPrivateRepositoryWithPinnedFingerprint() {
+        val repos = repositories(helper.writableDatabase)
+
+        assertEquals(1, repos.size)
+        val repo = repos.single()
+        assertEquals(StoreConfig.REPO_URL, repo.address)
+        assertEquals("Ming Store", repo.name)
+        assertEquals(
+            StoreConfig.REPO_FINGERPRINT,
+            repo.fingerprint,
+        )
+        assertTrue(repo.enabled)
+        assertEquals(0L, repo.updated)
+        assertTrue(repo.mirrors.isEmpty())
+        // Database.init returns this flag to trigger Droidify's initial automatic sync.
+        assertTrue(helper.created)
+        assertFalse(helper.updated)
+        verify(exactly = 0) { OemRepositoryParser.getSystemDefaultRepos() }
+    }
+
+    @Test
+    fun reopeningPreservesDisabledRepositoryEditsAndUserAddedRepositories() {
+        val db = helper.writableDatabase
+        val privateRepo = repositories(db).single().copy(
+            address = "https://custom.example.invalid/repo",
+            fingerprint = "USER_PIN",
+            authentication = "USER_AUTH",
+            enabled = false,
+        )
+        RepositoryAdapter.put(privateRepo, database = db)
+        RepositoryAdapter.put(
+            Repository.newRepository("https://extra.example.invalid/repo", "EXTRA_PIN", ""),
+            database = db,
+        )
+        val expected = repositories(db)
+
+        val reopened = reopen()
+
+        assertEquals(expected, repositories(reopened))
+        assertFalse(helper.created)
+        assertFalse(helper.updated)
+    }
+
+    @Test
+    fun upgradingPreservesDisabledStateAndRepositoryConfiguration() {
+        val db = helper.writableDatabase
+        val privateRepo = repositories(db).single().copy(
+            enabled = false,
+            fingerprint = "USER_PIN",
+            name = "My repository",
+        )
+        RepositoryAdapter.put(privateRepo, database = db)
+        db.version -= 1
+
+        val upgraded = reopen()
+
+        assertEquals(listOf(privateRepo), repositories(upgraded))
+        assertFalse(helper.created)
+        assertTrue(helper.updated)
+        verify(exactly = 0) { OemRepositoryParser.getSystemDefaultRepos() }
+    }
+
+    @Test
+    fun intentionallyEmptyRepositoryListStaysEmptyAcrossReopenAndUpgrade() {
+        val db = helper.writableDatabase
+        db.delete(Schema.Repository.name, null, null)
+
+        val reopened = reopen()
+        assertTrue(repositories(reopened).isEmpty())
+        assertFalse(helper.created)
+        assertFalse(helper.updated)
+
+        reopened.version -= 1
+        val upgraded = reopen()
+        assertTrue(repositories(upgraded).isEmpty())
+        assertFalse(helper.created)
+        assertTrue(helper.updated)
+    }
+
+    private fun reopen(): SQLiteDatabase {
+        helper.close()
+        helper = DatabaseHelper(context)
+        return helper.writableDatabase
+    }
+
+    private fun repositories(db: SQLiteDatabase): List<Repository> = buildList {
+        db.query(
+            Schema.Repository.name,
+            null,
+            "${Schema.Repository.ROW_DELETED} = 0",
+            null,
+            null,
+            null,
+            Schema.Repository.ROW_ID,
+        ).use { cursor ->
+            while (cursor.moveToNext()) {
+                val data = cursor.getBlob(cursor.getColumnIndexOrThrow(Schema.Repository.ROW_DATA))
+                add(
+                    data.jsonParse { it.repository() }.copy(
+                        id = cursor.getLong(cursor.getColumnIndexOrThrow(Schema.Repository.ROW_ID)),
+                        enabled = cursor.getInt(
+                            cursor.getColumnIndexOrThrow(Schema.Repository.ROW_ENABLED),
+                        ) != 0,
+                    ),
+                )
+            }
+        }
+    }
+}
